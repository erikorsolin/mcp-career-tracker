# ============================================================
# CareerTracker MCP - .gitignore
#
# ATENÇÃO - SEGURANÇA DA INFORMAÇÃO
# Os arquivos de dados deste projeto contêm informações estratégicas
# da empresa (jargão interno, regras de negócio, métricas de impacto,
# nomes de sistemas). Eles NUNCA devem ser versionados.
# ============================================================

# ---------- Dados estratégicos (bloqueio estrito) ----------
# Sem barra inicial: o padrão vale em qualquer profundidade do repositório.
career_log.json
dominio_financeiro.json
data/*.json
data/*.jsonl
data/*.bak
# Backups e exportações eventuais
*.backup.json
brag_document*.md
# Mantém a pasta data/ no repositório, mas vazia
!data/.gitkeep

# ---------- Segredos e variáveis de ambiente ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Ambientes virtuais ----------
venv/
.venv/
env/
ENV/
venv.bak/
env.bak/

# ---------- Caches e artefatos do Python ----------
__pycache__/
*.py[codz]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
*.egg-info/
build/
dist/
.eggs/
.Python
pip-log.txt

# ---------- Ferramentas de gerenciamento ----------
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# ---------- IDEs e editores ----------
.vscode/
.idea/
*.swp
*.swo
tempCodeRunnerFile.py

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
