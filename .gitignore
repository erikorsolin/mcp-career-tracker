# ============================================================
# CareerTracker MCP - .gitignore
#
# ATENÇÃO - SEGURANÇA DA INFORMAÇÃO
# Os arquivos de dados deste projeto contêm informações estratégicas
# da empresa (jargão interno, regras de negócio, métricas de impacto,
# nomes de sistemas). Eles NUNCA devem ser versionados.
# ============================================================

# ---------- Dados estratégicos (bloqueio estrito) ----------
# Tudo dentro de data/: registros .md, subpastas e configuração do Obsidian
# (.obsidian/, .trash/).
data/**
# Mantém a pasta data/ no repositório, mas vazia
!data/.gitkeep
# Relatórios exportados eventualmente
brag_document*.md
# Configuração local do Obsidian (ex: ao abrir examples/data-exemplo como cofre)
.obsidian/
.trash/

# ---------- Segredos e variáveis de ambiente ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Ambientes virtuais ----------
venv/
.venv/
env/
ENV/
venv.bak/
env.bak/

# ---------- Caches e artefatos do Python ----------
__pycache__/
*.py[codz]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
*.egg-info/
build/
dist/
.eggs/
.Python
pip-log.txt

# ---------- Ferramentas de gerenciamento ----------
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# ---------- IDEs e editores ----------
.vscode/
.idea/
*.swp
*.swo
tempCodeRunnerFile.py

# ---------- Sistema operacional ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
